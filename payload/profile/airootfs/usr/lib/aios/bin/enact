#!/bin/sh
# L-04 allowlisted root helper. Does not curl (HI-04, L-20). No /usr outside pacman.
set -eu

PATH="/usr/bin:/usr/sbin:/bin:/sbin"
export PATH

BRAKE=/srv/aios/state/brake.d/stamp
# Root-owned; not in an aios-agent worktree (L-20). P5 writes this at accept.
ACCEPT_STAMP=/etc/aios/envelope-accepted
STATE=/srv/aios/state
PIN="${STATE}/packages.txt"
MAP="${STATE}/esp-generations"
STATE_BARE=/srv/aios/git/state.git
GENROOT=/boot/aios-gen
WINDOW_LOCK=/run/aios/enact.window
STATE_INDEX=
DESTROOT=
BOOT=/boot
ENTRIES=/boot/loader/entries
BTRFS_MNT=/run/aios-btrfs

# Four live images only; 1G ESP cannot hold fallback initramfs copies (L-19).
ESP_FILES="vmlinuz-linux vmlinuz-linux-lts initramfs-linux.img initramfs-linux-lts.img"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

log() {
  printf 'enact: %s\n' "$*" >&2
}

usage() {
  printf 'usage: enact {syu|snapper-pre|snapper-post|bootctl|unit|rollback|synthesise} ...\n' >&2
  exit 2
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "enact must run as root (L-04)"
}

require_not_frozen() {
  [ ! -e "${BRAKE}" ] || die "enact frozen (L-12)"
}

require_accept_stamp() {
  [ -f "${ACCEPT_STAMP}" ] || die "enact refuses until envelope accept (L-20)"
  # Destroot oracles create the stamp as the test uid; live still requires root.
  if [ -n "${DESTROOT}" ]; then
    return 0
  fi
  _uid=$(stat -c '%u' "${ACCEPT_STAMP}")
  [ "${_uid}" = 0 ] || die "accept stamp is not root-owned (L-20)"
  _mod=$(stat -c '%a' "${ACCEPT_STAMP}")
  _g=$(printf '%s' "${_mod}" | awk '{print substr($0,length($0)-1,1)}')
  _o=$(printf '%s' "${_mod}" | awk '{print substr($0,length($0),1)}')
  case "${_g}" in
    2|3|6|7) die "accept stamp is group-writable (L-20)" ;;
  esac
  case "${_o}" in
    2|3|6|7) die "accept stamp is other-writable (L-20)" ;;
  esac
}

normalize_unit() {
  _u=$1
  case "${_u}" in
    */*) _u=${_u##*/} ;;
  esac
  printf '%s\n' "${_u}"
}

is_aios_unit() {
  _u=$1
  case "${_u}" in
    */*|*..*|*" "*) return 1 ;;
  esac
  case "${_u}" in
    aios-*.service|aios-*.socket|aios-*.timer|aios-*.slice|aios-*.target|aios-*.path) return 0 ;;
  esac
  return 1
}

is_seatbelt_unit() {
  case "$1" in
    aios-checker.service|snapper-timeline.timer|snapper-cleanup.timer) return 0 ;;
    etckeeper.timer|etckeeper.service) return 0 ;;
  esac
  return 1
}

is_user_unit() {
  case "$1" in
    aios-work-runtime.service|aios-work-runtime-bots.service) return 0 ;;
  esac
  return 1
}

validate_unit() {
  [ "$#" -eq 2 ] || die "unit takes ACTION UNIT only"
  _act=$1
  _unit=$(normalize_unit "$2")
  case "${_act}" in
    disable|mask|stop|restart|try-restart|reload|reload-or-restart|kill)
      if is_seatbelt_unit "${_unit}"; then
        die "refuse to ${_act} ${_unit} (HI-06)"
      fi
      if [ "${_unit}" = aios-agent.service ]; then
        die "refuse to ${_act} aios-agent.service (L-12 human brake only)"
      fi
      ;;
  esac
  if is_user_unit "${_unit}"; then
    die "${_unit} is a user unit (L-23)"
  fi
  case "${_act}" in
    enable|disable|start|stop|mask|unmask|is-enabled|is-active) ;;
    *) die "unit action not allowlisted: ${_act}" ;;
  esac
  is_aios_unit "${_unit}" || die "unit is not an aios-* unit: ${_unit}"
}

# Best-effort: pin files / worktree .git back to aios-agent; bare repo to aios-checker (L-03).
# Must not die: this runs on EXIT after a failed commit/push.
restore_owners() {
  if [ -d "${STATE}" ]; then
    _own=$(stat -c '%U:%G' "${STATE}" 2>/dev/null || true)
    if [ -n "${_own}" ]; then
      [ ! -f "${PIN}" ] || chown "${_own}" "${PIN}" 2>/dev/null || true
      [ ! -f "${MAP}" ] || chown "${_own}" "${MAP}" 2>/dev/null || true
      [ ! -d "${STATE}/.git" ] || chown -R "${_own}" "${STATE}/.git" 2>/dev/null || true
    fi
  fi
  if [ -d "${STATE_BARE}" ] && id -u aios-checker >/dev/null 2>&1; then
    chown -R aios-checker:aios-checker "${STATE_BARE}" 2>/dev/null || true
  fi
  [ -z "${STATE_INDEX}" ] || rm -f "${STATE_INDEX}" 2>/dev/null || true
  rm -f "${STATE}/esp-generations.tmp."* "${STATE}/packages.txt.tmp."* 2>/dev/null || true
}

# Two windows interleaving pre/post/ESP would leave a snapper id without a boot image (HI-06).
acquire_window() {
  command -v flock >/dev/null 2>&1 || die "flock missing"
  mkdir -p "$(dirname "${WINDOW_LOCK}")" || die "mkdir $(dirname "${WINDOW_LOCK}") failed"
  exec 9>"${WINDOW_LOCK}"
  flock -n 9 || die "enact window already running"
  trap restore_owners EXIT
}

parse_slug() {
  _s=$1
  [ -n "${_s}" ] || die "empty slug"
  case "${_s}" in
    -*) die "slug must not start with -: ${_s}" ;;
    *[!A-Za-z0-9._-]*) die "slug must be [A-Za-z0-9._-]: ${_s}" ;;
  esac
  [ "${#_s}" -le 64 ] || die "slug too long"
  printf '%s\n' "${_s}"
}

require_numeric_id() {
  _id=$1
  _what=$2
  case "${_id}" in
    ''|*[!0-9]*) die "${_what} is not numeric: ${_id}" ;;
  esac
  [ "${_id}" -gt 0 ] || die "${_what} must be > 0"
}

require_kernels() {
  pacman -Q linux >/dev/null 2>&1 || die "linux is not installed (HI-06, L-19)"
  pacman -Q linux-lts >/dev/null 2>&1 || die "linux-lts is not installed (HI-06, L-19)"
}

# Snapper of @ does not include the ESP (HI-06). Refuse to record a false seatbelt.
require_esp() {
  command -v mountpoint >/dev/null 2>&1 || die "mountpoint missing"
  mountpoint -q /boot \
    || die "/boot is not a mount; refuse ESP copy onto @ (HI-06, L-19)"
  if command -v findmnt >/dev/null 2>&1; then
    _fstype=$(findmnt -n -o FSTYPE /boot) || die "cannot read /boot fstype"
    [ "${_fstype}" != btrfs ] \
      || die "/boot is btrfs; ESP is not in @ (HI-06)"
  fi
  mountpoint -q /srv \
    || die "/srv is not a mount; refuse packages.txt onto @ (L-07)"
  [ -d "${STATE}" ] || die "missing ${STATE}"
}

need_boot_file() {
  [ -s "$1" ] || die "missing or empty $1 (L-19)"
}

snapper_root() {
  /usr/bin/snapper --no-dbus -c root "$@"
}

create_pre() {
  _desc=$1
  _id=$(snapper_root create --type pre --print-number --description "pre ${_desc}") \
    || die "snapper pre failed"
  _id=$(printf '%s\n' "${_id}" | tr -d ' \t\r')
  require_numeric_id "${_id}" "snapper pre id"
  log "snapper pre ${_id}"
  printf '%s\n' "${_id}"
}

create_post() {
  _pre=$1
  _desc=$2
  _id=$(snapper_root create --type post --pre-number "${_pre}" \
    --print-number --description "post ${_desc}") \
    || die "snapper post failed"
  _id=$(printf '%s\n' "${_id}" | tr -d ' \t\r')
  require_numeric_id "${_id}" "snapper post id"
  log "snapper post ${_id} (pre ${_pre})"
  printf '%s\n' "${_id}"
}

# Same-window ESP copy keyed by post id: a snapper id without a boot image is not a seatbelt (HI-06, L-19).
copy_esp_generation() {
  _id=$1
  require_numeric_id "${_id}" "esp generation id"
  _gen="${GENROOT}/${_id}"
  mkdir -p "${_gen}" || die "mkdir ${_gen} failed"
  for _f in ${ESP_FILES}; do
    need_boot_file "/boot/${_f}"
    cp -a "/boot/${_f}" "${_gen}/${_f}" \
      || die "cp -a /boot/${_f} to aios-gen/${_id} failed"
    need_boot_file "${_gen}/${_f}"
  done
  log "ESP generation ${_id}"
}

generation_complete() {
  _gid=$1
  for _gf in ${ESP_FILES}; do
    [ -s "${GENROOT}/${_gid}/${_gf}" ] || return 1
  done
  return 0
}

map_last_id() {
  [ -f "${MAP}" ] || return 0
  grep -v '^[[:space:]]*#' "${MAP}" | grep -v '^[[:space:]]*$' | tail -n 1 | awk '{print $1}'
}

# Last map id, only if it is a complete generation other than post.
prev_from_map() {
  _post=$1
  _cand=$(map_last_id || true)
  case "${_cand}" in
    ''|*[!0-9]*) return 0 ;;
  esac
  [ "${_cand}" -gt 0 ] || return 0
  [ "${_cand}" != "${_post}" ] || return 0
  generation_complete "${_cand}" || return 0
  printf '%s\n' "${_cand}"
}

# Highest complete aios-gen id other than post. Used only when the map did not name a prev.
prev_from_disk() {
  _post=$1
  _best=
  [ -d "${GENROOT}" ] || return 0
  for _d in "${GENROOT}"/*; do
    [ -d "${_d}" ] || continue
    _id=${_d##*/}
    case "${_id}" in
      ''|*[!0-9]*) continue ;;
    esac
    [ "${_id}" -gt 0 ] || continue
    [ "${_id}" != "${_post}" ] || continue
    generation_complete "${_id}" || continue
    if [ -z "${_best}" ] || [ "${_id}" -gt "${_best}" ]; then
      _best=${_id}
    fi
  done
  printf '%s\n' "${_best}"
}

# Retention N=2: current post + previous successful post. Delete the rest in the same window.
# Atomic mv on /srv (same filesystem as MAP). Do not rm other gens unless prev is complete on disk.
retain_esp_generations() {
  _post=$1
  require_numeric_id "${_post}" "retain post id"
  generation_complete "${_post}" || die "current ESP generation ${_post} is incomplete (L-19)"

  _prev=$(prev_from_map "${_post}" || true)
  if [ -z "${_prev}" ]; then
    _prev=$(prev_from_disk "${_post}" || true)
  fi
  case "${_prev}" in
    ''|*[!0-9]*) _prev= ;;
  esac
  if [ -n "${_prev}" ]; then
    [ "${_prev}" -gt 0 ] || _prev=
  fi
  if [ -n "${_prev}" ] && ! generation_complete "${_prev}"; then
    _prev=
  fi

  _tmp="${STATE}/esp-generations.tmp.$$"
  {
    printf '%s\n' '# snapper_id esp_dir'
    if [ -n "${_prev}" ]; then
      printf '%s /boot/aios-gen/%s\n' "${_prev}" "${_prev}"
    fi
    printf '%s /boot/aios-gen/%s\n' "${_post}" "${_post}"
  } > "${_tmp}" || die "write ${_tmp} failed"
  mv -f "${_tmp}" "${MAP}" || die "atomic replace ${MAP} failed"

  [ -d "${GENROOT}" ] || die "missing ${GENROOT}"
  # Without a complete named prev, keep every aios-gen dir (truncated-map retry must not drop last-known-good).
  if [ -n "${_prev}" ]; then
    for _d in "${GENROOT}"/*; do
      [ -e "${_d}" ] || continue
      [ -d "${_d}" ] || die "unexpected non-directory in aios-gen: ${_d}"
      _id=${_d##*/}
      require_numeric_id "${_id}" "aios-gen directory"
      if [ "${_id}" = "${_post}" ] || [ "${_id}" = "${_prev}" ]; then
        continue
      fi
      rm -rf "${_d}" || die "failed to drop stale ESP generation ${_id}"
      log "dropped stale ESP generation ${_id}"
    done
    write_aios_prev "${_prev}"
  else
    # boot-seatbelt: aios-prev.conf must be absent until a second generation exists.
    rm -f /boot/loader/entries/aios-prev.conf
  fi
  printf '%s\n' "${_prev}"
}

# Firmware previous-kernel menu only; still rootflags=subvol=@. P7.7 restore is aios-rollback.conf, not this.
write_aios_prev() {
  _prev=$1
  require_numeric_id "${_prev}" "previous generation id"
  generation_complete "${_prev}" || die "previous ESP generation ${_prev} is incomplete (L-19)"
  [ -f /boot/loader/entries/aios-linux.conf ] \
    || die "missing /boot/loader/entries/aios-linux.conf"
  _opts=$(awk '/^options[[:space:]]/ { sub(/^options[[:space:]]+/, ""); print; exit }' \
    /boot/loader/entries/aios-linux.conf || true)
  [ -n "${_opts}" ] || die "aios-linux.conf has no options line"
  mkdir -p /boot/loader/entries || die "mkdir /boot/loader/entries failed"
  cat > /boot/loader/entries/aios-prev.conf <<EOF || die "write aios-prev.conf failed"
title   AIOS (previous)
linux   /aios-gen/${_prev}/vmlinuz-linux
initrd  /aios-gen/${_prev}/initramfs-linux.img
options ${_opts}
EOF
}

# Pacman -Qqe pin; linux and linux-lts stay explicit (HI-06).
write_packages_txt() {
  [ -d "${STATE}" ] || die "missing ${STATE}"
  _tmp="${STATE}/packages.txt.tmp.$$"
  pacman -Qqe > "${_tmp}" || die "pacman -Qqe failed"
  [ -s "${_tmp}" ] || die "pacman -Qqe produced no explicit packages"
  grep -qx linux "${_tmp}" || die "linux missing from packages.txt (HI-06)"
  grep -qx linux-lts "${_tmp}" || die "linux-lts missing from packages.txt (HI-06)"
  mv -f "${_tmp}" "${PIN}" || die "atomic replace ${PIN} failed"
}

clear_git_env() {
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
}

# Mechanical pin, not the proposer: author is aios so HI-03 (no aios-agent on main) stays true.
git_state() {
  git -c safe.directory="${STATE}" \
    -c user.name=aios \
    -c user.email=aios@localhost \
    -C "${STATE}" "$@"
}

git_bare() {
  git --git-dir="${STATE_BARE}" --work-tree="${STATE}" \
    -c safe.directory="${STATE_BARE}" \
    -c safe.directory="${STATE}" \
    -c user.name=aios \
    -c user.email=aios@localhost \
    "$@"
}

# Land only packages.txt + esp-generations on state.git main (git commit --only onto main, not HEAD).
record_state_git() {
  _pre=$1
  _post=$2
  _slug=$3
  clear_git_env
  [ -d "${STATE_BARE}/objects" ] || die "missing ${STATE_BARE} (HI-01)"
  [ -f "${PIN}" ] && [ -f "${MAP}" ] || die "pin files missing before state commit"
  git --git-dir="${STATE_BARE}" rev-parse --verify refs/heads/main >/dev/null 2>&1 \
    || die "${STATE_BARE} has no main"

  STATE_INDEX=/run/aios/enact.state.index.$$
  rm -f "${STATE_INDEX}"
  GIT_INDEX_FILE="${STATE_INDEX}"
  export GIT_INDEX_FILE
  GIT_AUTHOR_NAME=aios
  GIT_AUTHOR_EMAIL=aios@localhost
  GIT_COMMITTER_NAME=aios
  GIT_COMMITTER_EMAIL=aios@localhost
  export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

  # Capture main first; update-ref CAS below refuses a raced checker fast-forward (HI-01).
  _parent=$(git --git-dir="${STATE_BARE}" rev-parse refs/heads/main) \
    || die "rev-parse main failed"
  git_bare read-tree "${_parent}" \
    || die "git read-tree main failed"
  git_bare add -- packages.txt esp-generations \
    || die "git add pin files failed"
  if git_bare diff --cached --quiet; then
    log "state pin unchanged on main"
    rm -f "${STATE_INDEX}"
    STATE_INDEX=
    unset GIT_INDEX_FILE
    unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
    return 0
  fi
  _tree=$(git_bare write-tree) || die "git write-tree failed"
  _commit=$(git_bare commit-tree "${_tree}" -p "${_parent}" -m "feat(state): ${_slug} window

Snapshot: snapper pre #${_pre} post #${_post}
ESP: /boot/aios-gen/${_post}") \
    || die "git commit-tree main pin failed"
  git --git-dir="${STATE_BARE}" update-ref refs/heads/main "${_commit}" "${_parent}" \
    || die "update-ref main failed (non-ff or raced) (HI-01)"
  rm -f "${STATE_INDEX}"
  unset GIT_INDEX_FILE
  STATE_INDEX=
  unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

  # Root created objects in checker-owned state.git; restore L-03 before any later merge.
  id -u aios-checker >/dev/null 2>&1 || die "aios-checker missing (L-03)"
  chown -R aios-checker:aios-checker "${STATE_BARE}" \
    || die "chown ${STATE_BARE} failed (L-03)"

  clear_git_env
  if git -C "${STATE}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git_state fetch origin \
      || die "git fetch state origin failed"
    _br=$(git_state symbolic-ref --short HEAD 2>/dev/null || true)
    if [ "${_br}" = main ]; then
      # Unstaged pin files match origin/main but abort ff-only; stage them first.
      git_state add -- packages.txt esp-generations \
        || die "git add pin files in worktree failed"
      git_state merge --ff-only origin/main \
        || die "state worktree main failed to ff to pin (HI-01)"
    fi
  fi
}

run_policy() {
  _name=$1
  _tag=$2
  for _p in "/srv/aios/checker/policy/${_name}" "/usr/lib/aios/checker/policy/${_name}"; do
    if [ -x "${_p}" ]; then
      "${_p}" || die "${_name} failed after window (${_tag})"
      return 0
    fi
  done
  die "${_name} missing (${_tag})"
}

bootctl_update() {
  /usr/bin/bootctl --esp-path=/boot update \
    || die "bootctl update failed"
}

finish_window() {
  _pre=$1
  _post=$2
  _slug=$3
  require_esp
  require_kernels
  copy_esp_generation "${_post}"
  retain_esp_generations "${_post}" >/dev/null
  write_packages_txt
  record_state_git "${_pre}" "${_post}" "${_slug}"
  bootctl_update
  # Predicates must stay true after the window (HI-06, L-19); checker will re-run them.
  run_policy boot-seatbelt.sh "HI-06, L-19"
  run_policy packages-drift.sh "HI-01"
}

cmd_syu() {
  [ "$#" -le 1 ] || die "syu takes optional SLUG only"
  _slug=$(parse_slug "${1:-syu}")
  acquire_window
  require_esp
  require_kernels
  _pre=$(create_pre "${_slug}")
  # Full refresh+sysupgrade only. Partial pacman is not allowlisted (L-04, HI-06).
  /usr/bin/pacman -Syu --noconfirm || die "pacman -Syu failed"
  require_kernels
  _post=$(create_post "${_pre}" "${_slug}")
  finish_window "${_pre}" "${_post}" "${_slug}"
  printf 'pre %s\npost %s\nesp /boot/aios-gen/%s\n' "${_pre}" "${_post}" "${_post}"
}

cmd_snapper_pre() {
  [ "$#" -le 1 ] || die "snapper-pre takes optional SLUG only"
  _slug=$(parse_slug "${1:-enact}")
  acquire_window
  create_pre "${_slug}"
}

cmd_snapper_post() {
  [ "$#" -ge 1 ] || die "snapper-post requires pre-number"
  [ "$#" -le 2 ] || die "snapper-post takes PRE_NUMBER and optional SLUG"
  _pre=$1
  require_numeric_id "${_pre}" "pre-number"
  _slug=$(parse_slug "${2:-enact}")
  acquire_window
  require_esp
  _post=$(create_post "${_pre}" "${_slug}")
  finish_window "${_pre}" "${_post}" "${_slug}"
  printf 'pre %s\npost %s\nesp /boot/aios-gen/%s\n' "${_pre}" "${_post}" "${_post}"
}

cmd_bootctl() {
  [ "$#" -eq 1 ] || die "bootctl takes install|update|list only"
  case "$1" in
    install) exec /usr/bin/bootctl --esp-path=/boot install ;;
    update) exec /usr/bin/bootctl --esp-path=/boot update ;;
    list) exec /usr/bin/bootctl --esp-path=/boot list ;;
    *) die "bootctl action not allowlisted: $1" ;;
  esac
}

cmd_unit() {
  validate_unit "$@"
  _act=$1
  _unit=$(normalize_unit "$2")
  exec /usr/bin/systemctl --no-ask-password "${_act}" "${_unit}"
}

# HI-15: skip / "true" / 1 are not a yes. JSON true or compiled enabled: only.
work_runtime_yes() {
  _ans="${DESTROOT}/srv/aios/state/bootstrap-in-progress/answers.json"
  if [ -f "${_ans}" ] \
    && grep -Eq '"accepted"[[:space:]]*:[[:space:]]*true' "${_ans}" \
    && grep -Eq '"work_runtime"[[:space:]]*:[[:space:]]*true' "${_ans}"; then
    return 0
  fi
  _clause="${DESTROOT}/srv/aios/envelope/work-runtime.md"
  if [ -f "${_clause}" ] \
    && grep -Eq '^[[:space:]]*enabled[[:space:]]*[:=][[:space:]]*(true|yes|1)[[:space:]]*$' \
      "${_clause}"; then
    return 0
  fi
  return 1
}

# Seed → own git. Offline. No GitHub remote (HI-17).
materialise_work_tree() {
  _seed="${DESTROOT}/srv/aios/seeds/work-runtime"
  _dest="${DESTROOT}/srv/aios/src/work-runtime"
  [ -d "${_seed}" ] || die "seeds/work-runtime missing (HI-17)"
  [ -f "${_seed}/AGENTS.md" ] || die "seeds/work-runtime/AGENTS.md missing (HI-17)"
  if [ -d "${_dest}/.git" ]; then
    git -c safe.directory="${_dest}" -C "${_dest}" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || die "${_dest} is not a git repository"
    return 0
  fi
  [ ! -e "${_dest}" ] || die "${_dest} exists but is not a git repository"
  mkdir -p "${DESTROOT}/srv/aios/src" || die "mkdir ${DESTROOT}/srv/aios/src failed"
  mkdir -p "${_dest}" || die "mkdir ${_dest} failed"
  cp -a "${_seed}/." "${_dest}/" || die "copy seed to ${_dest} failed"
  rm -rf "${_dest}/.git"
  clear_git_env
  git -c safe.directory="${_dest}" -C "${_dest}" init -b main \
    || die "git init ${_dest} failed"
  git -c safe.directory="${_dest}" \
    -c user.name=aios-work \
    -c user.email=aios-work@localhost \
    -C "${_dest}" add -A \
    || die "git add ${_dest} failed"
  git -c safe.directory="${_dest}" \
    -c user.name=aios-work \
    -c user.email=aios-work@localhost \
    -C "${_dest}" commit -m "feat(work-runtime): synthesise from local seed

Copied from /srv/aios/seeds/work-runtime (HI-17). No remote." \
    || die "git commit ${_dest} failed"
  _origin=$(git -c safe.directory="${_dest}" -C "${_dest}" remote get-url origin 2>/dev/null || true)
  case "${_origin}" in
    *github*|*http://*|*https://*)
      die "work-runtime origin is ${_origin}, not local (HI-17)"
      ;;
  esac
  if [ -z "${DESTROOT}" ]; then
    id -u aios-work >/dev/null 2>&1 || die "aios-work missing (L-02)"
    chown -R aios-work:aios-work "${_dest}" \
      || die "chown ${_dest} failed"
  fi
  git -c safe.directory="${_dest}" -C "${_dest}" rev-parse --is-inside-work-tree >/dev/null \
    || die "${_dest} is not a git repository after synthesise"
}

# Destroot: wants symlink only. Live: systemctl --user -M; never unit enable (L-23).
enable_work_user_unit() {
  _unit=aios-work-runtime.service
  _tree="${DESTROOT}/srv/aios/src/work-runtime"
  if [ -n "${DESTROOT}" ]; then
    _wants="${DESTROOT}/etc/systemd/user/default.target.wants"
    mkdir -p "${_wants}" || die "mkdir ${_wants} failed"
    ln -sfn /usr/lib/systemd/user/aios-work-runtime.service \
      "${_wants}/${_unit}" \
      || die "wants symlink ${_unit} failed"
    return 0
  fi
  /usr/bin/systemctl --user -M aios-work@ enable "${_unit}" \
    || die "systemctl --user -M aios-work@ enable ${_unit} failed"
  # Start only when the runtime entrypoint exists; enable is the P8.1 seatbelt.
  if [ -d "${_tree}" ] && [ -f "${_tree}/main.py" ]; then
    /usr/bin/systemctl --user -M aios-work@ start "${_unit}" \
      || die "systemctl --user -M aios-work@ start ${_unit} failed"
  fi
}

cmd_synthesise() {
  [ "$#" -le 1 ] || die "synthesise takes optional work-runtime only"
  _target=${1:-work-runtime}
  [ "${_target}" = work-runtime ] \
    || die "not allowlisted: synthesise ${_target} (HI-15)"
  work_runtime_yes \
    || die "work runtime stays off until an explicit yes (HI-15)"
  if [ -n "${DESTROOT}" ]; then
    materialise_work_tree
    enable_work_user_unit
    printf 'synthesised %s\n' "${DESTROOT}/srv/aios/src/work-runtime"
    return 0
  fi
  acquire_window
  require_esp
  require_kernels
  _pre=$(create_pre "work-runtime")
  materialise_work_tree
  enable_work_user_unit
  _post=$(create_post "${_pre}" "work-runtime")
  finish_window "${_pre}" "${_post}" "work-runtime"
  printf 'synthesised /srv/aios/src/work-runtime\npre %s\npost %s\n' \
    "${_pre}" "${_post}"
}

# AIOS_ROOT destroot: host oracles write files without mutating workstation btrfs (P7.7).
bind_destroot() {
  _root=${AIOS_ROOT-}
  if [ -z "${_root}" ]; then
    DESTROOT=
    return 0
  fi
  while [ "${_root}" != / ] && [ "${_root%/}" != "${_root}" ]; do
    _root=${_root%/}
  done
  [ -n "${_root}" ] || die "AIOS_ROOT empty"
  case "${_root}" in
    /) die "AIOS_ROOT must not be /" ;;
    /*) ;;
    *) die "AIOS_ROOT must be absolute" ;;
  esac
  DESTROOT=${_root}
  BRAKE="${DESTROOT}/srv/aios/state/brake.d/stamp"
  ACCEPT_STAMP="${DESTROOT}/etc/aios/envelope-accepted"
  STATE="${DESTROOT}/srv/aios/state"
  PIN="${STATE}/packages.txt"
  MAP="${STATE}/esp-generations"
  GENROOT="${DESTROOT}/boot/aios-gen"
  BOOT="${DESTROOT}/boot"
  ENTRIES="${DESTROOT}/boot/loader/entries"
  BTRFS_MNT="${DESTROOT}/run/aios-btrfs"
  WINDOW_LOCK="${DESTROOT}/run/aios/enact.window"
}

map_ids() {
  [ -f "${MAP}" ] || die "missing ${MAP} (HI-06, L-19)"
  grep -v '^[[:space:]]*#' "${MAP}" | grep -v '^[[:space:]]*$' | awk '{print $1}'
}

snapper_xml_type() {
  _n=$1
  for _info in \
    "${BTRFS_MNT}/@snapshots/${_n}/info.xml" \
    "${DESTROOT}/.snapshots/${_n}/info.xml" \
    "/.snapshots/${_n}/info.xml"
  do
    [ -n "${_info}" ] || continue
    [ -f "${_info}" ] || continue
    if grep -q '<type>pre</type>' "${_info}"; then
      printf 'pre\n'
      return 0
    fi
    if grep -q '<type>post</type>' "${_info}"; then
      printf 'post\n'
      return 0
    fi
  done
  return 0
}

# N is a previous successful post in esp-generations with /boot/aios-gen/<N>/.
# Not the failed window's post (last map id). Not a pre id (L-19, HI-06).
validate_restore_n() {
  _n=$1
  require_numeric_id "${_n}" "rollback N"
  _last=$(map_last_id || true)
  [ -n "${_last}" ] || die "esp-generations has no generations (L-19)"
  [ "${_n}" != "${_last}" ] \
    || die "N must not be the failed window post id ${_last} (HI-06, L-19)"
  _found=0
  _count=0
  for _id in $(map_ids); do
    require_numeric_id "${_id}" "esp-generations id"
    _count=$((_count + 1))
    if [ "${_id}" = "${_n}" ]; then
      _found=1
    fi
  done
  [ "${_count}" -ge 2 ] || die "no previous successful post (L-19)"
  _ty=$(snapper_xml_type "${_n}" || true)
  if [ "${_ty}" = pre ]; then
    die "N ${_n} is a pre id; not an ESP generation key (L-19)"
  fi
  [ "${_found}" = 1 ] \
    || die "N ${_n} is not a successful post in esp-generations (L-19)"
  generation_complete "${_n}" \
    || die "missing or incomplete /boot/aios-gen/${_n}/ (HI-06, L-19)"
}

read_cmdline() {
  if [ -n "${AIOS_CMDLINE-}" ]; then
    printf '%s\n' "${AIOS_CMDLINE}"
    return 0
  fi
  if [ -n "${DESTROOT}" ]; then
    return 0
  fi
  [ -r /proc/cmdline ] || return 0
  cat /proc/cmdline
}

# Serial fixture: console=ttyS0 last so /dev/console stays serial.
cmdline_serial() {
  _cmd=$(read_cmdline || true)
  [ -n "${_cmd}" ] || return 1
  _last=
  for _tok in ${_cmd}; do
    case "${_tok}" in
      console=*) _last=${_tok} ;;
    esac
  done
  [ "${_last}" = "console=ttyS0" ]
}

on_restore_subvol() {
  _n=$1
  _cmd=$(read_cmdline || true)
  [ -n "${_cmd}" ] || return 1
  _want="subvol=@.restore-${_n}"
  for _tok in ${_cmd}; do
    case "${_tok}" in
      rootflags=*)
        case "${_tok}" in
          *"${_want}"*) return 0 ;;
        esac
        ;;
    esac
  done
  return 1
}

root_uuid() {
  _conf="${ENTRIES}/aios-linux.conf"
  [ -f "${_conf}" ] || die "missing ${ENTRIES}/aios-linux.conf"
  _uuid=$(awk '
    /^options[[:space:]]/ {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^root=UUID=/) {
          sub(/^root=UUID=/, "", $i)
          print $i
          exit
        }
      }
    }' "${_conf}")
  [ -n "${_uuid}" ] || die "aios-linux.conf has no root=UUID (L-19)"
  printf '%s\n' "${_uuid}"
}

set_boot_default() {
  _ent=$1
  mkdir -p "${BOOT}/loader" || die "mkdir ${BOOT}/loader failed"
  _loader="${BOOT}/loader/loader.conf"
  if [ -f "${_loader}" ]; then
    awk -v e="${_ent}" '
      BEGIN { done = 0 }
      /^default[[:space:]]/ { print "default " e; done = 1; next }
      { print }
      END { if (!done) print "default " e }
    ' "${_loader}" > "${_loader}.tmp" || die "write ${_loader}.tmp failed"
    mv -f "${_loader}.tmp" "${_loader}" || die "replace ${_loader} failed"
  else
    printf 'default %s\ntimeout 5\nconsole-mode keep\neditor no\n' "${_ent}" \
      > "${_loader}" || die "write ${_loader} failed"
  fi
  if [ -z "${DESTROOT}" ]; then
    /usr/bin/bootctl --esp-path=/boot set-default "${_ent}" \
      || log "bootctl set-default failed; loader.conf default=${_ent}"
  fi
}

# Do not boot the RO snapper snapshot as / (L-19, HI-06). Prefer subvol= over subvolid=.
write_rollback_conf() {
  _n=$1
  _uuid=$(root_uuid)
  _cons="console=tty0"
  _file=aios-rollback.conf
  if cmdline_serial; then
    _cons="console=tty0 console=ttyS0"
    _file=aios-rollback-serial.conf
  fi
  _subvol="@.restore-${_n}"
  case "${_subvol}" in
    @snapshots/*|*/snapshot) die "refuse RO snapper snapshot as / (L-19, HI-06)" ;;
  esac
  mkdir -p "${ENTRIES}" || die "mkdir ${ENTRIES} failed"
  cat > "${ENTRIES}/${_file}" <<EOF || die "write ${_file} failed"
title   AIOS rollback
linux   /aios-gen/${_n}/vmlinuz-linux
initrd  /aios-gen/${_n}/initramfs-linux.img
options root=UUID=${_uuid} rootflags=subvol=${_subvol} rw ${_cons}
EOF
  grep -Fq "rootflags=subvol=@.restore-${_n}" "${ENTRIES}/${_file}" \
    || die "rollback.conf missing subvol=@.restore-${_n} (L-19)"
  if grep -Fq 'rootflags=subvol=@snapshots/' "${ENTRIES}/${_file}"; then
    die "refuse RO snapper snapshot as / (L-19, HI-06)"
  fi
  if grep -Fq 'subvolid=' "${ENTRIES}/${_file}"; then
    die "prefer subvol= over subvolid= (L-19)"
  fi
  set_boot_default "${_file}"
  printf '%s\n' "${_file}"
}

mount_toplevel() {
  mkdir -p "${BTRFS_MNT}" || die "mkdir ${BTRFS_MNT} failed"
  if [ -n "${DESTROOT}" ]; then
    return 0
  fi
  if mountpoint -q "${BTRFS_MNT}"; then
    return 0
  fi
  _src=$(findmnt -n -o SOURCE /) || die "cannot find root device"
  # Toplevel is subvolid=5 so we can name @ / @.restore-N / @snapshots (L-19).
  mount -o subvolid=5 "${_src}" "${BTRFS_MNT}" \
    || die "mount toplevel subvolid=5 failed"
}

# RW clone only. Never a read-only btrfs snapshot. Never snapper restore verbs.
clone_restore() {
  _n=$1
  _src="${BTRFS_MNT}/@snapshots/${_n}/snapshot"
  _dst="${BTRFS_MNT}/@.restore-${_n}"
  if [ -n "${DESTROOT}" ]; then
    mkdir -p "${BTRFS_MNT}/@" "${_src}" "${_dst}" \
      || die "destroot restore dirs failed"
    printf 'rw\n' > "${_dst}/.aios-restore" \
      || die "destroot restore marker failed"
    return 0
  fi
  [ -d "${_src}" ] || die "missing snapper snapshot ${_n} at ${_src} (L-19)"
  if [ -e "${_dst}" ]; then
    _ro=$(btrfs property get -ts "${_dst}" ro 2>/dev/null || true)
    case "${_ro}" in
      *true*) die "existing @.restore-${_n} is RO; refuse (L-19, HI-06)" ;;
    esac
    log "reuse RW @.restore-${_n}"
    return 0
  fi
  btrfs subvolume snapshot "${_src}" "${_dst}" \
    || die "RW snapshot @.restore-${_n} failed (L-19)"
  _ro=$(btrfs property get -ts "${_dst}" ro 2>/dev/null || true)
  case "${_ro}" in
    *true*) die "restore clone is RO; refuse to boot it (L-19, HI-06)" ;;
  esac
  log "RW clone @.restore-${_n}"
}

write_linux_entry() {
  _file=$1
  _title=$2
  _linux=$3
  _initrd=$4
  _cons=$5
  _uuid=$6
  cat > "${ENTRIES}/${_file}" <<EOF || die "write ${_file} failed"
title   ${_title}
linux   ${_linux}
initrd  ${_initrd}
options root=UUID=${_uuid} rootflags=subvol=@ rw ${_cons}
EOF
  grep -Eq '^linux[[:space:]]+/vmlinuz-linux' "${ENTRIES}/${_file}" \
    || die "${_file} linux path (L-19)"
  grep -Fq 'rootflags=subvol=@' "${ENTRIES}/${_file}" \
    || die "${_file} must use rootflags=subvol=@ (L-19)"
  if grep -Fq 'subvolid=' "${ENTRIES}/${_file}"; then
    die "prefer subvol= over subvolid= (L-19)"
  fi
  if grep -Fq 'rootflags=subvol=@snapshots/' "${ENTRIES}/${_file}"; then
    die "refuse RO snapper snapshot as / (L-19, HI-06)"
  fi
}

restore_esp_live() {
  _n=$1
  generation_complete "${_n}" || die "ESP generation ${_n} is incomplete (L-19)"
  mkdir -p "${BOOT}" || die "mkdir ${BOOT} failed"
  for _f in ${ESP_FILES}; do
    cp -a "${GENROOT}/${_n}/${_f}" "${BOOT}/${_f}" \
      || die "cp -a aios-gen/${_n}/${_f} to /boot failed"
    need_boot_file "${BOOT}/${_f}"
  done
}

check_fstab_subvol() {
  _fstab=/etc/fstab
  if [ -n "${DESTROOT}" ]; then
    _fstab="${DESTROOT}/etc/fstab"
  fi
  [ -f "${_fstab}" ] || return 0
  _rootline=$(awk '$1 !~ /^#/ && $2 == "/" { print; exit }' "${_fstab}" || true)
  [ -n "${_rootline}" ] || return 0
  printf '%s\n' "${_rootline}" | grep -q 'subvol=@' \
    || die "fstab must keep subvol=@ (L-19)"
  printf '%s\n' "${_rootline}" | grep -q 'subvolid=' \
    && die "prefer subvol= over subvolid= (L-19)" || true
}

promote_restore() {
  _n=$1
  mount_toplevel
  _at="${BTRFS_MNT}/@"
  _rest="${BTRFS_MNT}/@.restore-${_n}"
  _brok="${BTRFS_MNT}/@.broken-${_n}"
  # Idempotent after a successful promote: cmdline still names @.restore-N
  # until the next reboot (L-19 step 5). Do not die or spam refuse.
  if [ -e "${_brok}" ] && [ ! -e "${_rest}" ]; then
    [ -e "${_at}" ] || die "missing @ after promote (L-19)"
    log "already promoted @.restore-${_n} -> @ (L-19)"
    return 0
  fi
  [ -e "${_rest}" ] || die "missing @.restore-${_n}; not on restore clone (L-19)"
  [ ! -e "${_brok}" ] || die "@.broken-${_n} already exists"
  [ -e "${_at}" ] || die "missing @ to rename"
  mv "${_at}" "${_brok}" || die "rename @ -> @.broken-${_n} failed"
  mv "${_rest}" "${_at}" || die "rename @.restore-${_n} -> @ failed"
  mkdir -p "${STATE}" || die "mkdir ${STATE} failed"
  printf '%s\n' "@.broken-${_n}" > "${STATE}/broken-subvol" \
    || die "record broken-subvol failed (HI-09)"
  check_fstab_subvol
  restore_esp_live "${_n}"
  _uuid=$(root_uuid)
  mkdir -p "${ENTRIES}" || die "mkdir ${ENTRIES} failed"
  write_linux_entry aios-linux.conf "AIOS (linux)" \
    /vmlinuz-linux /initramfs-linux.img "console=tty0" "${_uuid}"
  write_linux_entry aios-linux-lts.conf "AIOS (linux-lts)" \
    /vmlinuz-linux-lts /initramfs-linux-lts.img "console=tty0" "${_uuid}"
  write_linux_entry aios-linux-serial.conf "AIOS (linux, serial)" \
    /vmlinuz-linux /initramfs-linux.img "console=tty0 console=ttyS0" "${_uuid}"
  write_linux_entry aios-linux-lts-serial.conf "AIOS (linux-lts, serial)" \
    /vmlinuz-linux-lts /initramfs-linux-lts.img "console=tty0 console=ttyS0" "${_uuid}"
  rm -f "${ENTRIES}/aios-rollback.conf" "${ENTRIES}/aios-rollback-serial.conf"
  if cmdline_serial; then
    set_boot_default aios-linux-serial.conf
  else
    set_boot_default aios-linux.conf
  fi
  log "promoted @.restore-${_n} -> @; @.broken-${_n} recorded (L-19)"
}

prepare_restore() {
  _n=$1
  mount_toplevel
  clone_restore "${_n}"
  _ent=$(write_rollback_conf "${_n}")
  log "wrote ${_ent}; reboot into RW @.restore-${_n} (L-19)"
  printf 'restore @.restore-%s\nentry %s\n' "${_n}" "${_ent}"
}

cmd_rollback() {
  [ "$#" -ge 1 ] || die "rollback requires N"
  [ "$#" -le 2 ] || die "rollback takes N and optional promote"
  bind_destroot
  _n=$1
  _mode=${2-}
  case "${_mode}" in
    ''|promote) ;;
    *) die "rollback action not allowlisted: ${_mode}" ;;
  esac
  validate_restore_n "${_n}"
  acquire_window
  require_accept_stamp
  # L-19 restore is a human TUI action; L-12 freeze is the proposer, not this path.
  if [ "${_mode}" = promote ] || on_restore_subvol "${_n}"; then
    promote_restore "${_n}"
    printf 'promoted @.restore-%s -> @\nbroken @.broken-%s\n' "${_n}" "${_n}"
    return 0
  fi
  prepare_restore "${_n}"
}

main() {
  [ "$#" -ge 1 ] || usage
  # Allowlist/deny before root so the oracle can argv-parse without privilege.
  case "$1" in
    -S*|pacman)
      die "partial pacman is not allowlisted (L-04); use enact syu"
      ;;
    syu|snapper-pre|snapper-post|bootctl|unit|rollback|synthesise|synthesize) ;;
    *)
      die "not allowlisted: $1"
      ;;
  esac
  _cmd=$1
  shift
  if [ "${_cmd}" = unit ]; then
    validate_unit "$@"
  fi
  if [ "${_cmd}" = synthesise ] || [ "${_cmd}" = synthesize ]; then
    # Bit check before root so host oracles see HI-15 without privilege.
    bind_destroot
    _syn_target=${1:-work-runtime}
    [ "${_syn_target}" = work-runtime ] \
      || die "not allowlisted: synthesise ${_syn_target} (HI-15)"
    work_runtime_yes \
      || die "work runtime stays off until an explicit yes (HI-15)"
    if [ -z "${AIOS_ROOT-}" ]; then
      require_root
    fi
    require_not_frozen
    require_accept_stamp
    cmd_synthesise "$@"
    return
  fi
  if [ "${_cmd}" = rollback ]; then
    # Destroot file writes (AIOS_ROOT) are host oracles; live still needs root.
    if [ -z "${AIOS_ROOT-}" ]; then
      require_root
    fi
    cmd_rollback "$@"
    return
  fi
  require_root
  require_not_frozen
  require_accept_stamp
  case "${_cmd}" in
    syu) cmd_syu "$@" ;;
    snapper-pre) cmd_snapper_pre "$@" ;;
    snapper-post) cmd_snapper_post "$@" ;;
    bootctl) cmd_bootctl "$@" ;;
    unit) cmd_unit "$@" ;;
    *) die "not allowlisted: ${_cmd}" ;;
  esac
}

main "$@"
