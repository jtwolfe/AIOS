#!/bin/sh
# L-09: TTY TUI owns /dev/console until accept. Not enabled on the live ISO.
# L-18: named views, not a raw question script. L-20: Harness A; no sysupgrade.
MAIN=/usr/lib/aios/installer/aios_installer/main.py

if [ ! -f "${MAIN}" ]; then
  printf '%s\n' 'AIOS installer: missing aios_installer/main.py (L-09)'
  while true; do
    sleep 3600
  done
fi

if [ ! -x /usr/bin/python3 ]; then
  printf '%s\n' 'AIOS installer: python3 missing (L-01); idle (L-09)'
  while true; do
    sleep 3600
  done
fi

exec /usr/bin/python3 -u "${MAIN}" "$@"
