#!/bin/sh
# Live ISO only. Getty autologin execs this; it is not a product root shell.
# Harness A: pacstrap the locked list, never a sysupgrade. No aios-firstboot.service (HI-12).
set -eu
set -o pipefail 2>/dev/null || true

umask 022
PATH="/usr/bin:/usr/sbin:/bin:/sbin"
export PATH
cd /

AIOS_LIB=/usr/lib/aios
PACSTRAP_LIST="${AIOS_LIB}/pacstrap.x86_64"
HASHES="${AIOS_LIB}/hashes.txt"
MINISIGN_PUB="${AIOS_LIB}/minisign.pub"
TARGET=/mnt
RUN_DIR=/run/aios
LIVE_LOG="${RUN_DIR}/aios-firstboot.log"
CAND_FILE="${RUN_DIR}/disks"
ISO_FILE="${RUN_DIR}/iso-devs"
TARGET_MOUNTED=0

mkdir -p "${RUN_DIR}"
touch "${LIVE_LOG}"

this_tty() {
  _t=$(tty 2>/dev/null || true)
  if [ -n "${_t}" ]; then
    printf '%s\n' "${_t}"
    return 0
  fi
  _t=$(readlink /proc/self/fd/0 2>/dev/null || true)
  printf '%s\n' "${_t}"
}

# Mirror progress to the other live getty so QEMU -serial stdio and a VT both see it.
fanout_line() {
  _line=$1
  _self=$(this_tty)
  for _d in /dev/ttyS0 /dev/tty1; do
    [ -c "${_d}" ] || continue
    [ "${_d}" = "${_self}" ] && continue
    printf '%s\n' "${_line}" >"${_d}" 2>/dev/null || true
  done
}

log() {
  printf '%s\n' "$*" >> "${LIVE_LOG}"
  printf '%s\n' "$*"
  fanout_line "$*"
}

tee_consoles() {
  _self=$(this_tty)
  _tee="${LIVE_LOG}"
  for _d in /dev/ttyS0 /dev/tty1; do
    [ -c "${_d}" ] || continue
    [ "${_d}" = "${_self}" ] && continue
    _tee="${_tee} ${_d}"
  done
  # shellcheck disable=SC2086
  tee -a ${_tee}
}

die() {
  log "error: $*"
  log "firstboot failed; idle so the console can be read"
  sleep 86400
  exit 1
}

copy_log() {
  if [ -d "${TARGET}/var/log" ] && [ -f "${LIVE_LOG}" ]; then
    cp -a "${LIVE_LOG}" "${TARGET}/var/log/aios-firstboot.log"
  fi
}

cleanup() {
  copy_log 2>/dev/null || true
  if [ "${TARGET_MOUNTED}" = 1 ]; then
    umount -R "${TARGET}" 2>/dev/null || true
    TARGET_MOUNTED=0
  fi
}
trap cleanup EXIT

fw_cfg() {
  _p="/sys/firmware/qemu_fw_cfg/by_name/${1}/raw"
  [ -r "${_p}" ] || return 1
  tr -d '\0\r\n' < "${_p}"
}

require_live_iso() {
  if [ -d /run/archiso ] || grep -qw archisobasedir /proc/cmdline 2>/dev/null; then
    return 0
  fi
  die "firstboot is live-ISO only"
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "firstboot must run as root"
}

require_uefi() {
  [ -d /sys/firmware/efi ] || die "UEFI firmware required"
  [ -d /sys/firmware/efi/efivars ] || die "EFI variables missing (need OVMF)"
}

require_tools() {
  for _c in pacstrap genfstab arch-chroot sgdisk mkfs.fat mkfs.btrfs btrfs \
    mount umount mountpoint bootctl lsblk blkid findmnt sha256sum minisign \
    systemctl cp tee udevadm partx systemd-sysusers systemd-tmpfiles \
    flock ip wipefs; do
    command -v "${_c}" >/dev/null 2>&1 || die "missing ${_c}"
  done
  [ -f "${PACSTRAP_LIST}" ] || die "missing ${PACSTRAP_LIST}"
  grep -qx linux "${PACSTRAP_LIST}" || die "linux missing from pacstrap list"
  grep -qx linux-lts "${PACSTRAP_LIST}" || die "linux-lts missing from pacstrap list"
}

console_serial() {
  _fw=$(fw_cfg opt/org.aios/console || true)
  [ "${_fw}" = serial ]
}

# One installer. Prefer ttyS0 when fw_cfg asks for serial (QEMU -serial stdio).
is_operator_instance() {
  _t=$(this_tty)
  if console_serial; then
    case "${_t}" in
      /dev/ttyS0|/dev/console) return 0 ;;
      *) return 1 ;;
    esac
  fi
  case "${_t}" in
    /dev/ttyS0) return 1 ;;
  esac
  return 0
}

# Non-operator getty: never take the exclusive lock (that blocked the installer).
spectate() {
  printf '%s\n' "firstboot is on the operator console; this TTY follows the log."
  touch "${LIVE_LOG}"
  if command -v tail >/dev/null 2>&1; then
    tail -n +1 -f "${LIVE_LOG}" || true
  fi
  while true; do
    sleep 86400
  done
}

acquire_lock() {
  if is_operator_instance; then
    exec 9>"${RUN_DIR}/firstboot.lock"
    flock 9 || die "could not lock firstboot"
    return 0
  fi
  spectate
  exit 0
}

# Confirm on the operator TTY (serial when fw_cfg console=serial).
read_operator() {
  _var=$1
  _dev=$(this_tty)
  if console_serial && [ -r /dev/ttyS0 ]; then
    _dev=/dev/ttyS0
  elif [ -z "${_dev}" ] || [ ! -r "${_dev}" ]; then
    if [ -r /dev/tty ]; then
      _dev=/dev/tty
    else
      _dev=
    fi
  fi
  if [ -n "${_dev}" ]; then
    read -r "${_var}" <"${_dev}"
  else
    read -r "${_var}"
  fi
}

# hashes.txt + minisign must pass before any block device is touched.
verify_payload() {
  [ -f "${HASHES}" ] || die "missing ${HASHES} (refuse before disks)"
  [ -f "${MINISIGN_PUB}" ] || die "missing ${MINISIGN_PUB} (refuse before disks)"
  [ -f "${HASHES}.minisig" ] || die "missing ${HASHES}.minisig (refuse before disks)"
  minisign -Vm "${HASHES}" -p "${MINISIGN_PUB}" >/dev/null \
    || die "minisign verify failed (refuse before disks)"
  while IFS= read -r _line || [ -n "${_line}" ]; do
    case "${_line}" in
      ''|\#*) continue ;;
    esac
    _hash=${_line%% *}
    _path=${_line#* }
    _path=${_path# }
    _path=${_path#\*}
    [ -n "${_hash}" ] && [ -n "${_path}" ] || die "bad hashes.txt line"
    case "${_path}" in
      /*) _abs=${_path} ;;
      *) _abs="${AIOS_LIB}/${_path}" ;;
    esac
    [ -e "${_abs}" ] || die "hashed path missing: ${_abs}"
    printf '%s  %s\n' "${_hash}" "${_abs}" | sha256sum -c --status - \
      || die "hash mismatch: ${_abs}"
  done < "${HASHES}"
  log "payload hashes and minisign ok"
}

collect_iso_devs() {
  : > "${ISO_FILE}"
  for _w in $(cat /proc/cmdline); do
    case "${_w}" in
      archisosearchuuid=*)
        _u=${_w#archisosearchuuid=}
        if [ -e "/dev/disk/by-uuid/${_u}" ]; then
          _real=$(readlink -f "/dev/disk/by-uuid/${_u}")
          printf '%s\n' "${_real}" >> "${ISO_FILE}"
          _pk=$(lsblk -dn -o PKNAME "${_real}" 2>/dev/null || true)
          if [ -n "${_pk}" ]; then
            printf '%s\n' "/dev/${_pk}" >> "${ISO_FILE}"
          fi
        fi
        ;;
    esac
  done
  _src=$(findmnt -n -o SOURCE /run/archiso/bootmnt 2>/dev/null || true)
  if [ -n "${_src}" ]; then
    _real=$(readlink -f "${_src}" 2>/dev/null || printf '%s' "${_src}")
    printf '%s\n' "${_real}" >> "${ISO_FILE}"
    _pk=$(lsblk -dn -o PKNAME "${_real}" 2>/dev/null || true)
    if [ -n "${_pk}" ]; then
      printf '%s\n' "/dev/${_pk}" >> "${ISO_FILE}"
    fi
  fi
}

is_iso_related() {
  _disk=$1
  [ -f "${ISO_FILE}" ] || return 1
  while IFS= read -r _x; do
    [ -z "${_x}" ] && continue
    [ "${_disk}" = "${_x}" ] && return 0
    case "${_x}" in
      "${_disk}"*) return 0 ;;
    esac
  done < "${ISO_FILE}"
  return 1
}

# Candidate disks exclude the ISO, rom, loop, airootfs (L-07 probe).
probe_disks() {
  collect_iso_devs
  : > "${CAND_FILE}"
  log "probing block devices"
  if ! lsblk -dn -p -o NAME,TYPE > "${RUN_DIR}/lsblk"; then
    die "lsblk failed"
  fi
  while read -r _name _type _rest || [ -n "${_name}" ]; do
    [ "${_type}" = disk ] || continue
    case "${_name}" in
      /dev/loop*|/dev/sr*|/dev/rom*|/dev/zram*|/dev/ram*|/dev/fd*|/dev/md*|/dev/nbd*)
        continue
        ;;
    esac
    if is_iso_related "${_name}"; then
      continue
    fi
    _base=${_name#/dev/}
    [ -r "/sys/block/${_base}/size" ] || continue
    _sectors=$(cat "/sys/block/${_base}/size") || continue
    # 4 GiB in 512-byte sectors: 1G ESP plus a usable root.
    [ "${_sectors}" -ge 8388608 ] || continue
    printf '%s\n' "${_name}" >> "${CAND_FILE}"
  done < "${RUN_DIR}/lsblk"
  return 0
}

count_cands() {
  if [ ! -s "${CAND_FILE}" ]; then
    printf '0'
    return
  fi
  wc -l < "${CAND_FILE}" | tr -d ' '
}

firstboot_mode() {
  _mode=confirm
  _fw=$(fw_cfg opt/org.aios/firstboot || true)
  [ "${_fw}" = auto ] && _mode=auto
  for _w in $(cat /proc/cmdline); do
    case "${_w}" in
      aios.firstboot=auto) _mode=auto ;;
    esac
  done
  for _w in $(cat /proc/cmdline); do
    case "${_w}" in
      aios.firstboot=confirm) _mode=confirm ;;
    esac
  done
  printf '%s\n' "${_mode}"
}

confirm_disk() {
  _mode=$(firstboot_mode)
  _n=$(count_cands)
  log "disk probe: ${_n} candidate(s), mode=${_mode}"
  if [ "${_n}" = 0 ]; then
    die "no candidate disk"
  fi
  while IFS= read -r _d; do
    log "  candidate ${_d}"
  done < "${CAND_FILE}"

  if [ "${_mode}" = auto ]; then
    if [ "${_n}" != 1 ]; then
      die "auto requires exactly one candidate disk (found ${_n})"
    fi
    DISK=$(head -n 1 "${CAND_FILE}")
    log "auto: using ${DISK}"
    return 0
  fi

  if [ "${_n}" = 1 ]; then
    DISK=$(head -n 1 "${CAND_FILE}")
    log "Install AIOS to ${DISK} (this erases the disk)."
    log "Type yes to continue."
    read_operator _ans || die "no TTY confirm"
    [ "${_ans}" = yes ] || die "not confirmed"
    return 0
  fi

  log "Type the disk path to install (this erases it), or abort."
  read_operator _ans || die "no TTY confirm"
  _d=0
  while IFS= read -r DISK; do
    if [ "${DISK}" = "${_ans}" ]; then
      _d=1
      break
    fi
  done < "${CAND_FILE}"
  [ "${_d}" = 1 ] || die "not a candidate disk: ${_ans}"
  log "confirmed ${DISK}"
}

part_node() {
  _disk=$1
  _n=$2
  case "${_disk}" in
    *[0-9]) printf '%sp%s\n' "${_disk}" "${_n}" ;;
    *) printf '%s%s\n' "${_disk}" "${_n}" ;;
  esac
}

wait_block() {
  _p=$1
  _i=0
  while [ "${_i}" -lt 30 ]; do
    [ -b "${_p}" ] && return 0
    sleep 1
    _i=$((_i + 1))
  done
  die "partition ${_p} did not appear"
}

partition_and_mount() {
  ESP=$(part_node "${DISK}" 1)
  ROOTP=$(part_node "${DISK}" 2)
  if findmnt "${DISK}" >/dev/null 2>&1 || findmnt "${ESP}" >/dev/null 2>&1 \
    || findmnt "${ROOTP}" >/dev/null 2>&1; then
    die "${DISK} is already mounted; refuse to repartition"
  fi
  log "partition GPT L-07 on ${DISK}"
  sgdisk --zap-all "${DISK}" >/dev/null || die "sgdisk zap-all failed"
  sgdisk --clear "${DISK}" >/dev/null || die "sgdisk clear failed"
  sgdisk -n 1:0:+1G -t 1:EF00 -c 1:esp "${DISK}" >/dev/null || die "sgdisk ESP failed"
  sgdisk -n 2:0:0 -t 2:8300 -c 2:rootfs "${DISK}" >/dev/null || die "sgdisk rootfs failed"
  partx -u "${DISK}" 2>/dev/null || true
  udevadm settle || true
  wait_block "${ESP}"
  wait_block "${ROOTP}"
  wipefs -a "${ESP}" >/dev/null 2>&1 || true
  wipefs -a "${ROOTP}" >/dev/null 2>&1 || true
  mkfs.fat -F 32 "${ESP}" >/dev/null || die "mkfs.fat ESP failed"
  mkfs.btrfs -f "${ROOTP}" >/dev/null || die "mkfs.btrfs root failed"
  udevadm settle || true
  blkid -c /dev/null "${ESP}" "${ROOTP}" >/dev/null || true
  mount "${ROOTP}" "${TARGET}"
  btrfs subvolume create "${TARGET}/@" >/dev/null
  btrfs subvolume create "${TARGET}/@home" >/dev/null
  btrfs subvolume create "${TARGET}/@srv" >/dev/null
  btrfs subvolume create "${TARGET}/@var_log" >/dev/null
  btrfs subvolume create "${TARGET}/@snapshots" >/dev/null
  umount "${TARGET}"
  mount -o subvol=@ "${ROOTP}" "${TARGET}"
  mount --mkdir "${ESP}" "${TARGET}/boot"
  mount --mkdir -o subvol=@home "${ROOTP}" "${TARGET}/home"
  mount --mkdir -o subvol=@srv "${ROOTP}" "${TARGET}/srv"
  mount --mkdir -o subvol=@var_log "${ROOTP}" "${TARGET}/var/log"
  mount --mkdir -o subvol=@snapshots "${ROOTP}" "${TARGET}/.snapshots"
  TARGET_MOUNTED=1
  ROOT_UUID=$(blkid -c /dev/null -s UUID -o value "${ROOTP}")
  [ -n "${ROOT_UUID}" ] || die "no UUID on root filesystem"
  copy_log
}

wait_network() {
  _i=0
  while [ "${_i}" -lt 60 ]; do
    if [ -n "$(ip -4 route show default 2>/dev/null || true)" ]; then
      return 0
    fi
    sleep 1
    _i=$((_i + 1))
  done
  die "no IPv4 default route before pacstrap"
}

pacstrap_target() {
  wait_network
  _pkgs=$(grep -v '^#' "${PACSTRAP_LIST}" | grep -v '^[[:space:]]*$' || true)
  [ -n "${_pkgs}" ] || die "empty pacstrap list"
  log "pacstrap -K from ${PACSTRAP_LIST}"
  # Word splitting of the locked name list is intended.
  # shellcheck disable=SC2086
  pacstrap -K "${TARGET}" ${_pkgs} 2>&1 | tee_consoles
}

write_boot_entry() {
  _dest=$1
  _title=$2
  _linux=$3
  _initrd=$4
  _cons=$5
  cat > "${_dest}" <<EOF
title   ${_title}
linux   ${_linux}
initrd  ${_initrd}
options root=UUID=${ROOT_UUID} rootflags=subvol=@ rw ${_cons}
EOF
}

configure_boot() {
  mkdir -p "${TARGET}/boot/loader/entries"
  log "bootctl install"
  if ! arch-chroot -S "${TARGET}" /usr/bin/bootctl --esp-path=/boot install; then
    bootctl --root="${TARGET}" --esp-path=/boot install \
      || die "bootctl install failed; UEFI variables require OVMF"
  fi
  write_boot_entry "${TARGET}/boot/loader/entries/aios-linux.conf" \
    "AIOS (linux)" /vmlinuz-linux /initramfs-linux.img "console=tty0"
  write_boot_entry "${TARGET}/boot/loader/entries/aios-linux-lts.conf" \
    "AIOS (linux-lts)" /vmlinuz-linux-lts /initramfs-linux-lts.img "console=tty0"
  write_boot_entry "${TARGET}/boot/loader/entries/aios-linux-serial.conf" \
    "AIOS (linux, serial)" /vmlinuz-linux /initramfs-linux.img "console=tty0 console=ttyS0"
  write_boot_entry "${TARGET}/boot/loader/entries/aios-linux-lts-serial.conf" \
    "AIOS (linux-lts, serial)" /vmlinuz-linux-lts /initramfs-linux-lts.img "console=tty0 console=ttyS0"
  if console_serial; then
    DEFAULT_ENTRY=aios-linux-serial.conf
  else
    DEFAULT_ENTRY=aios-linux.conf
  fi
  cat > "${TARGET}/boot/loader/loader.conf" <<EOF
default ${DEFAULT_ENTRY}
timeout 5
console-mode keep
editor no
EOF
  log "loader.conf default ${DEFAULT_ENTRY}"
  if ! bootctl --root="${TARGET}" set-default "${DEFAULT_ENTRY}"; then
    log "bootctl set-default failed; loader.conf default=${DEFAULT_ENTRY}"
  fi
}

write_os_release() {
  _body='NAME="AIOS"
PRETTY_NAME="AIOS"
ID=aios
ID_LIKE=arch
VERSION="dev"
VERSION_ID="dev"
'
  printf '%s' "${_body}" > "${TARGET}/usr/lib/os-release"
  ln -sfn ../usr/lib/os-release "${TARGET}/etc/os-release"
}

copy_if_present() {
  _src=$1
  _dest=$2
  if [ -e "${_src}" ]; then
    mkdir -p "$(dirname "${_dest}")"
    cp -a "${_src}" "${_dest}"
  fi
}

# HI-17: payload seeds become local git objects. Do not synthesise /srv/aios/src (HI-15).
materialise_seeds() {
  mountpoint -q "${TARGET}/srv" \
    || die "/srv is not mounted; refuse to write seeds onto @"
  mkdir -p "${TARGET}/srv/aios/seeds" || die "mkdir /srv/aios/seeds failed"
  [ ! -e "${TARGET}/srv/aios/src" ] || die "/srv/aios/src must not exist (HI-15)"

  if [ ! -d "${TARGET}/srv/aios/seeds/work-runtime" ] \
    || [ ! -d "${TARGET}/srv/aios/seeds/work-runtime-bots" ]; then
    _copied=0
    if [ -d "${AIOS_LIB}/seeds" ]; then
      cp -a "${AIOS_LIB}/seeds/." "${TARGET}/srv/aios/seeds/" \
        || die "copy ${AIOS_LIB}/seeds failed"
      _copied=1
    fi
    if [ -d /srv/aios/seeds ]; then
      cp -a /srv/aios/seeds/. "${TARGET}/srv/aios/seeds/" \
        || die "copy /srv/aios/seeds failed"
      _copied=1
    fi
    [ "${_copied}" = 1 ] || die "payload seeds missing (HI-17)"
  fi

  [ -d "${TARGET}/srv/aios/seeds/work-runtime" ] \
    || die "work-runtime seed missing (HI-17)"
  [ -d "${TARGET}/srv/aios/seeds/work-runtime-bots" ] \
    || die "work-runtime-bots seed missing (HI-17)"
  [ -f "${TARGET}/srv/aios/envelope/hard-invariants.md" ] \
    || die "envelope/hard-invariants.md missing (HI-17)"
  [ ! -e "${TARGET}/srv/aios/src" ] || die "/srv/aios/src must not exist (HI-15)"
}

copy_payload_into_target() {
  mkdir -p "${TARGET}/usr/lib/aios/bin" \
    "${TARGET}/usr/lib/sysusers.d" \
    "${TARGET}/usr/lib/tmpfiles.d" \
    "${TARGET}/etc/systemd/system" \
    "${TARGET}/srv/aios/envelope" \
    "${TARGET}/srv/aios/seeds" \
    "${TARGET}/srv/aios/checker"
  copy_if_present "${AIOS_LIB}/bin/installer" "${TARGET}/usr/lib/aios/bin/installer"
  copy_if_present "${AIOS_LIB}/bin/enact" "${TARGET}/usr/lib/aios/bin/enact"
  copy_if_present "${PACSTRAP_LIST}" "${TARGET}/usr/lib/aios/pacstrap.x86_64"
  copy_if_present /usr/lib/sysusers.d/aios.conf "${TARGET}/usr/lib/sysusers.d/aios.conf"
  copy_if_present /usr/lib/tmpfiles.d/aios.conf "${TARGET}/usr/lib/tmpfiles.d/aios.conf"
  copy_if_present /etc/systemd/system/aios-installer.service \
    "${TARGET}/etc/systemd/system/aios-installer.service"
  copy_if_present /etc/systemd/system/aios-checker.service \
    "${TARGET}/etc/systemd/system/aios-checker.service"
  copy_if_present "${AIOS_LIB}/hard-invariants.md" \
    "${TARGET}/srv/aios/envelope/hard-invariants.md"
  copy_if_present "${AIOS_LIB}/envelope/hard-invariants.md" \
    "${TARGET}/srv/aios/envelope/hard-invariants.md"
  # Checker source becomes the /srv/aios/checker worktree (HI-02). Not enabled on the live ISO.
  [ -d "${AIOS_LIB}/checker/aios_checker" ] \
    || die "payload checker source missing"
  cp -a "${AIOS_LIB}/checker/." "${TARGET}/srv/aios/checker/" \
    || die "copy checker source failed"
  materialise_seeds
  [ -x "${TARGET}/usr/lib/aios/bin/installer" ] \
    || die "installer missing on target"
  [ -f "${TARGET}/etc/systemd/system/aios-installer.service" ] \
    || die "aios-installer.service missing on target"
  [ -f "${TARGET}/etc/systemd/system/aios-checker.service" ] \
    || die "aios-checker.service missing on target"
  [ -f "${TARGET}/srv/aios/checker/aios_checker/schema.py" ] \
    || die "checker schema.py missing on target"
}

# pacstrap bind-mounts /run onto /mnt/run; teardown can drop nested L-07 mounts.
ensure_l07_mounts() {
  mountpoint -q "${TARGET}" || die "target ${TARGET} is not a mountpoint after pacstrap"
  [ -n "${ESP}" ] && [ -b "${ESP}" ] || die "ESP partition missing after pacstrap"
  [ -n "${ROOTP}" ] && [ -b "${ROOTP}" ] || die "root partition missing after pacstrap"
  [ -n "${ROOT_UUID}" ] || die "root UUID unset after pacstrap"
  mountpoint -q "${TARGET}/boot" \
    || mount --mkdir "${ESP}" "${TARGET}/boot" \
    || die "remount ESP failed"
  mountpoint -q "${TARGET}/home" \
    || mount --mkdir -o subvol=@home "${ROOTP}" "${TARGET}/home" \
    || die "remount @home failed"
  mountpoint -q "${TARGET}/srv" \
    || mount --mkdir -o subvol=@srv "${ROOTP}" "${TARGET}/srv" \
    || die "remount @srv failed"
  mountpoint -q "${TARGET}/var/log" \
    || mount --mkdir -o subvol=@var_log "${ROOTP}" "${TARGET}/var/log" \
    || die "remount @var_log failed"
  mountpoint -q "${TARGET}/.snapshots" \
    || mount --mkdir -o subvol=@snapshots "${ROOTP}" "${TARGET}/.snapshots" \
    || die "remount @snapshots failed"
}

# L-07 fstab from the UUIDs firstboot just created. genfstab is logged; it is
# not the product file (empty here when findmnt sees no rows after pacstrap).
write_l07_fstab() {
  _esp_uuid=$(blkid -c /dev/null -s UUID -o value "${ESP}")
  [ -n "${_esp_uuid}" ] || die "no UUID on ESP"
  cat > "${TARGET}/etc/fstab" <<EOF
# L-07: ESP vfat /boot (not in btrfs); subvol= not subvolid= (Btrfs wiki).
UUID=${_esp_uuid} /boot vfat defaults 0 2
UUID=${ROOT_UUID} / btrfs defaults,subvol=@ 0 0
UUID=${ROOT_UUID} /home btrfs defaults,subvol=@home 0 0
UUID=${ROOT_UUID} /srv btrfs defaults,subvol=@srv 0 0
UUID=${ROOT_UUID} /var/log btrfs defaults,subvol=@var_log 0 0
UUID=${ROOT_UUID} /.snapshots btrfs defaults,subvol=@snapshots 0 0
EOF
  grep -q 'subvol=@,' "${TARGET}/etc/fstab" || grep -q 'subvol=@ ' "${TARGET}/etc/fstab" \
    || die "fstab missing subvol=@"
}

configure_target() {
  udevadm settle || true
  ensure_l07_mounts
  copy_log
  genfstab -U "${TARGET}" > "${RUN_DIR}/genfstab.out" 2>"${RUN_DIR}/genfstab.err" || true
  if [ -s "${RUN_DIR}/genfstab.out" ]; then
    log "genfstab produced $(wc -l < "${RUN_DIR}/genfstab.out" | tr -d ' ') lines (L-07 fstab is authoritative)"
  else
    log "genfstab produced no lines ($(tr '\n' ' ' < "${RUN_DIR}/genfstab.err" 2>/dev/null || true))"
  fi
  write_l07_fstab

  printf 'aios\n' > "${TARGET}/etc/hostname"
  cat > "${TARGET}/etc/hosts" <<'EOF'
127.0.0.1 localhost
::1       localhost
127.0.1.1 aios
EOF
  ln -sfn /usr/share/zoneinfo/UTC "${TARGET}/etc/localtime"
  printf 'en_US.UTF-8 UTF-8\n' > "${TARGET}/etc/locale.gen"
  printf 'LANG=en_US.UTF-8\n' > "${TARGET}/etc/locale.conf"
  arch-chroot "${TARGET}" locale-gen >/dev/null
  write_os_release

  mkdir -p "${TARGET}/etc/systemd/network"
  cat > "${TARGET}/etc/systemd/network/20-wired.network" <<'EOF'
[Match]
Name=en* eth*
[Network]
DHCP=yes
EOF
  cat > "${TARGET}/etc/systemd/zram-generator.conf" <<'EOF'
[zram0]
zram-size = ram / 2
EOF
  ln -sfn /run/systemd/resolve/stub-resolv.conf "${TARGET}/etc/resolv.conf"

  copy_payload_into_target
  systemd-sysusers --root="${TARGET}"
  systemd-tmpfiles --root="${TARGET}" --create \
    --prefix=/srv/aios --prefix=/run/aios || true

  systemctl --root="${TARGET}" enable aios-installer.service \
    || die "failed to enable aios-installer.service in the chroot"
  # HI-06: checker stays enabled on the installed disk. Not enabled on the live ISO.
  systemctl --root="${TARGET}" enable aios-checker.service \
    || die "failed to enable aios-checker.service in the chroot"
  systemctl --root="${TARGET}" mask getty@tty1.service serial-getty@ttyS0.service \
    || die "failed to mask gettys (installer must own /dev/console)"
  systemctl --root="${TARGET}" enable systemd-networkd.service systemd-resolved.service \
    || die "failed to enable networkd/resolved"
  systemctl --root="${TARGET}" disable sshd.service 2>/dev/null || true
  systemctl --root="${TARGET}" disable openssh.service 2>/dev/null || true
  systemctl --root="${TARGET}" disable iwd.service 2>/dev/null || true
  systemctl --root="${TARGET}" is-enabled aios-installer.service >/dev/null \
    || die "aios-installer.service not enabled in the chroot"
  systemctl --root="${TARGET}" is-enabled aios-checker.service >/dev/null \
    || die "aios-checker.service not enabled in the chroot"
  _g1=$(systemctl --root="${TARGET}" is-enabled getty@tty1.service 2>/dev/null || true)
  _gs=$(systemctl --root="${TARGET}" is-enabled serial-getty@ttyS0.service 2>/dev/null || true)
  [ "${_g1}" = masked ] || die "getty@tty1.service is not masked on the target"
  [ "${_gs}" = masked ] || die "serial-getty@ttyS0.service is not masked on the target"
  if systemctl --root="${TARGET}" is-enabled sshd.service >/dev/null 2>&1 \
    || systemctl --root="${TARGET}" is-enabled openssh.service >/dev/null 2>&1; then
    die "openssh/sshd must stay disabled"
  fi

  arch-chroot "${TARGET}" mkinitcpio -P 2>&1 | tee_consoles
}

# Wiki Snapper suggested layout: nested .snapshots under @ would hide @snapshots.
# HI-06 / L-19: first ESP generation is keyed by snapper id, not a timestamp.
configure_snapper() {
  [ -x "${TARGET}/usr/bin/snapper" ] || die "snapper missing on target"
  [ -n "${ROOTP}" ] && [ -b "${ROOTP}" ] || die "root partition missing for snapper"
  mountpoint -q "${TARGET}/.snapshots" \
    || die "/.snapshots is not the @snapshots mount"
  umount "${TARGET}/.snapshots" || die "umount /.snapshots failed"
  rmdir "${TARGET}/.snapshots" || die "remove /.snapshots mountpoint failed"
  arch-chroot "${TARGET}" /usr/bin/snapper --no-dbus -c root create-config / \
    || die "snapper -c root create-config failed"
  btrfs subvolume delete "${TARGET}/.snapshots" >/dev/null \
    || die "could not delete snapper nested .snapshots under @"
  mkdir -p "${TARGET}/.snapshots" || die "mkdir /.snapshots failed"
  mount -o subvol=@snapshots "${ROOTP}" "${TARGET}/.snapshots" \
    || die "remount @snapshots at /.snapshots failed"
  chmod 750 "${TARGET}/.snapshots" || die "chmod 750 /.snapshots failed"

  # Nested /home/.snapshots stays a subvolume of @home; do not mount @snapshots there.
  arch-chroot "${TARGET}" /usr/bin/snapper --no-dbus -c home create-config /home \
    || die "snapper -c home create-config failed"
  [ -d "${TARGET}/home/.snapshots" ] || die "home .snapshots missing after create-config"
  ! mountpoint -q "${TARGET}/home/.snapshots" \
    || die "home .snapshots must not be a mount (do not mount @snapshots there)"
  btrfs subvolume show "${TARGET}/home/.snapshots" >/dev/null \
    || die "home .snapshots is not a btrfs subvolume of @home"

  systemctl --root="${TARGET}" enable snapper-timeline.timer snapper-cleanup.timer \
    || die "failed to enable snapper timers"
  systemctl --root="${TARGET}" is-enabled snapper-timeline.timer >/dev/null \
    || die "snapper-timeline.timer not enabled"
  systemctl --root="${TARGET}" is-enabled snapper-cleanup.timer >/dev/null \
    || die "snapper-cleanup.timer not enabled"
  log "snapper root and home configs"
}

create_first_snapshot() {
  SNAP_ID=$(arch-chroot "${TARGET}" /usr/bin/snapper --no-dbus -c root create \
    --type single --print-number --description firstboot) \
    || die "snapper create firstboot snapshot failed"
  SNAP_ID=$(printf '%s\n' "${SNAP_ID}" | tr -d ' \t\r')
  case "${SNAP_ID}" in
    ''|*[!0-9]*) die "snapper print-number gave '${SNAP_ID}'" ;;
  esac
  [ "${SNAP_ID}" -gt 0 ] || die "snapper id must be > 0"
  log "snapper root id ${SNAP_ID}"
}

copy_first_esp_generation() {
  [ -n "${SNAP_ID}" ] || die "snapper id unset for ESP generation"
  mountpoint -q "${TARGET}/boot" \
    || die "ESP /boot is not mounted; refuse to write aios-gen onto @"
  mountpoint -q "${TARGET}/srv" \
    || die "/srv is not mounted; refuse to write esp-generations onto @"
  _gen="${TARGET}/boot/aios-gen/${SNAP_ID}"
  mkdir -p "${_gen}" || die "mkdir ${_gen} failed"
  # Four live images only; 1G ESP cannot hold fallback initramfs copies.
  for _f in vmlinuz-linux vmlinuz-linux-lts initramfs-linux.img initramfs-linux-lts.img; do
    [ -f "${TARGET}/boot/${_f}" ] || die "missing /boot/${_f} for ESP generation"
    cp -a "${TARGET}/boot/${_f}" "${_gen}/${_f}" \
      || die "cp -a /boot/${_f} to aios-gen/${SNAP_ID} failed"
  done
  mkdir -p "${TARGET}/srv/aios/state" || die "mkdir /srv/aios/state failed"
  cat > "${TARGET}/srv/aios/state/esp-generations" <<EOF || die "write esp-generations failed"
# snapper_id esp_dir
${SNAP_ID} /boot/aios-gen/${SNAP_ID}
EOF
  [ -f "${_gen}/vmlinuz-linux" ] && [ -f "${_gen}/vmlinuz-linux-lts" ] \
    && [ -f "${_gen}/initramfs-linux.img" ] && [ -f "${_gen}/initramfs-linux-lts.img" ] \
    || die "ESP generation ${SNAP_ID} missing a kernel or initramfs"
  [ ! -e "${TARGET}/boot/loader/entries/aios-prev.conf" ] \
    || die "aios-prev.conf must be absent until a second generation exists"
  log "ESP generation ${SNAP_ID}"
}

write_packages_txt() {
  mountpoint -q "${TARGET}/srv" \
    || die "/srv is not mounted; refuse to write packages.txt onto @"
  mkdir -p "${TARGET}/srv/aios/state" || die "mkdir /srv/aios/state failed"
  arch-chroot "${TARGET}" pacman -Qqe > "${TARGET}/srv/aios/state/packages.txt" \
    || die "pacman -Qqe failed"
  grep -qx linux "${TARGET}/srv/aios/state/packages.txt" \
    || die "linux missing from packages.txt"
  grep -qx linux-lts "${TARGET}/srv/aios/state/packages.txt" \
    || die "linux-lts missing from packages.txt"
}

init_etc_mirror() {
  [ -x "${TARGET}/usr/bin/etckeeper" ] || die "etckeeper missing on target"
  [ -x "${TARGET}/usr/bin/git" ] || die "git missing on target"
  mountpoint -q "${TARGET}/srv" \
    || die "/srv is not mounted; refuse to write etc-mirror onto @"
  [ ! -e "${TARGET}/srv/aios/etc-mirror" ] || die "etc-mirror already exists"
  arch-chroot "${TARGET}" /usr/bin/etckeeper init \
    || die "etckeeper init failed"
  arch-chroot "${TARGET}" /usr/bin/git -C /etc config user.name aios \
    || die "etckeeper git user.name failed"
  arch-chroot "${TARGET}" /usr/bin/git -C /etc config user.email aios@localhost \
    || die "etckeeper git user.email failed"
  if ! arch-chroot "${TARGET}" /usr/bin/git -C /etc rev-parse --verify HEAD >/dev/null 2>&1; then
    arch-chroot "${TARGET}" /usr/bin/etckeeper commit firstboot \
      || die "etckeeper commit failed"
  fi
  arch-chroot "${TARGET}" /usr/bin/git -C /etc rev-parse --verify HEAD >/dev/null \
    || die "etckeeper has no HEAD"
  arch-chroot "${TARGET}" /usr/bin/git init --bare /srv/aios/etc-mirror \
    || die "etc-mirror git init failed"
  arch-chroot "${TARGET}" /usr/bin/git -C /etc remote add origin /srv/aios/etc-mirror \
    || die "etc-mirror remote add failed"
  _br=$(arch-chroot "${TARGET}" /usr/bin/git -C /etc symbolic-ref --short HEAD) \
    || die "etckeeper HEAD is not a branch"
  [ -n "${_br}" ] || die "etckeeper branch name empty"
  arch-chroot "${TARGET}" /usr/bin/git -C /etc push origin "HEAD:refs/heads/${_br}" \
    || die "etc-mirror push failed"
  [ -d "${TARGET}/srv/aios/etc-mirror" ] || die "etc-mirror missing"
}

# Root (oracles, recovery) is not aios-checker; git 2.35+ refuses other-owner dirs.
write_git_safe_directory() {
  [ -x "${TARGET}/usr/bin/git" ] || die "git missing on target"
  for _p in \
    /srv/aios/git/envelope.git \
    /srv/aios/git/memory.git \
    /srv/aios/git/skills.git \
    /srv/aios/git/agent.git \
    /srv/aios/git/checker.git \
    /srv/aios/git/state.git \
    /srv/aios/git/seeds.git \
    /srv/aios/envelope \
    /srv/aios/memory \
    /srv/aios/skills \
    /srv/aios/agent \
    /srv/aios/checker \
    /srv/aios/state \
    /srv/aios/seeds
  do
    arch-chroot "${TARGET}" /usr/bin/git config --system --add safe.directory "${_p}" \
      || die "git safe.directory ${_p} failed"
  done
}

write_machine_agents_md() {
  cat > "${TARGET}/srv/aios/AGENTS.md" <<'EOF' || die "write /srv/aios/AGENTS.md failed"
# AGENTS.md

This file is the contract for any AI agent working on this machine.
Nested AGENTS.md files in subdirectories override this file for their
tree. Direct human instruction always wins, except where a hard
invariant forbids it; those conflicts are raised, not swallowed.

Canonical hard invariants: envelope/hard-invariants.md (HI-01 … HI-17).
Quote them by id. Do not extend them in this file.

Do not invent a parallel handbook in the prompt.

## What this is

AIOS is an operating system a privileged AI agent maintains so the human
does not have to administer the machine. Definitional and reconstructible:
a living envelope of checkable conditions on Arch Linux, enacted as local
git.

It is not a person, not a new language, and not a memory product. The
privileged agent is a systemd service, not a self.

An optional work runtime for user tasks may be synthesised at bootstrap.
It is not privileged. It files intents at /run/aios/intent.sock. The
kernel enforces the boundary. The work runtime stays off until the
envelope records an explicit yes (HI-15).

## Non-negotiable

1. Never enact a privileged change that fails mechanical validation against
   the current envelope.
2. A privileged proposal is intent plus oracles. No oracle set, no enactment.
3. All code you write and all software you install is recorded in local git.
   No unversioned live mutations (HI-01).
4. Never commit to main as the proposer. Branch, test, request merge, wait
   for the checker (HI-03, L-03).
5. Never force-push, never rewrite published history, never curl|sh, never
   mutate /usr outside pacman (HI-04).
6. The human is the source of the highest conditions and the emergency brake.
   The human is not CI — you verify (HI-05, HI-08).
7. Prefer editing existing files to creating new ones.
8. Do not invent a parallel envelope, skill tree, architecture, language, or
   identity store (HI-12).
9. The proposing model does not decide what memory is worth keeping (HI-11).
10. Work agents never enact privileged change. They file intents. The
    privilege boundary is an OS property (HI-13, HI-16), not a request to
    the model.

Bare privileged git is under /srv/aios/git/, owned by aios-checker (L-03).
Agent working trees are /srv/aios/<name> and push only refs/heads/agent/*.
EOF
  [ -f "${TARGET}/srv/aios/AGENTS.md" ] || die "/srv/aios/AGENTS.md missing"
}

install_hook_stubs() {
  _hookdir="${TARGET}/srv/aios/git/${1}.git/hooks"
  mkdir -p "${_hookdir}" || die "mkdir ${_hookdir} failed"
  for _h in update pre-receive reference-transaction; do
    cat > "${_hookdir}/${_h}" <<'EOF' || die "write git hook failed"
#!/bin/sh
# L-03 hook path (HI-02, HI-03).
exit 0
EOF
    chmod 0755 "${_hookdir}/${_h}" || die "chmod ${_hookdir}/${_h} failed"
  done
}

# L-03 / HI-01: checker-owned bare git; working copy at /srv/aios/<name> with origin push.
init_one_git() {
  _name=$1
  case "${_name}" in
    envelope)
      _purpose='Current checkable conditions. Canonical hard invariants: hard-invariants.md.'
      ;;
    memory)
      _purpose='Operational history. Significant exchanges are stored verbatim (HI-11).'
      ;;
    skills)
      _purpose='Crystallized SKILL.md files for the privileged agent.'
      ;;
    agent)
      _purpose='Privileged proposer. Does not merge to main (HI-03).'
      ;;
    checker)
      _purpose='Independent validator. No model client (HI-02).'
      ;;
    state)
      _purpose='System-intent log: installs, units, snapshots. packages.txt is pacman -Qqe.'
      ;;
    seeds)
      _purpose='Payload-materialised seed trees (HI-17). Reconstruction does not fetch GitHub.'
      ;;
    *)
      die "unknown git tree ${_name}"
      ;;
  esac
  _wt="/srv/aios/${_name}"
  _bare="/srv/aios/git/${_name}.git"
  _host_wt="${TARGET}${_wt}"
  _host_bare="${TARGET}${_bare}"

  [ ! -e "${_host_bare}" ] || die "${_bare} already exists"
  [ ! -e "${_host_wt}/.git" ] || die "${_wt} is already a git repo"
  mkdir -p "${_host_wt}" || die "mkdir ${_wt} failed"

  if [ ! -f "${_host_wt}/README.md" ]; then
    printf '# %s\n\n%s\n' "${_name}" "${_purpose}" > "${_host_wt}/README.md" \
      || die "write ${_wt}/README.md failed"
  fi
  if [ ! -f "${_host_wt}/.gitignore" ]; then
    printf '# Local git is the source of truth (HI-01).\n' > "${_host_wt}/.gitignore" \
      || die "write ${_wt}/.gitignore failed"
  fi
  if [ "${_name}" = envelope ]; then
    [ -f "${_host_wt}/hard-invariants.md" ] \
      || die "${_wt}/hard-invariants.md missing before git"
  fi

  arch-chroot "${TARGET}" /usr/bin/git init -b main "${_wt}" \
    || die "git init ${_wt} failed"
  arch-chroot "${TARGET}" /usr/bin/git -C "${_wt}" add -A \
    || die "git add ${_wt} failed"
  arch-chroot "${TARGET}" /usr/bin/git \
    -c user.name=aios \
    -c user.email=aios@localhost \
    -C "${_wt}" \
    commit -m "chore(${_name}): initialise tree" \
    || die "git commit ${_wt} failed"
  arch-chroot "${TARGET}" /usr/bin/git init --bare -b main "${_bare}" \
    || die "git init --bare ${_bare} failed"
  arch-chroot "${TARGET}" /usr/bin/git -C "${_wt}" remote add origin "${_bare}" \
    || die "git remote add ${_name} failed"
  arch-chroot "${TARGET}" /usr/bin/git -C "${_wt}" push -u origin main \
    || die "git push ${_name} main failed"
  install_hook_stubs "${_name}"
  [ -x "${_host_bare}/hooks/update" ] \
    && [ -x "${_host_bare}/hooks/pre-receive" ] \
    && [ -x "${_host_bare}/hooks/reference-transaction" ] \
    || die "${_bare} hook paths missing"
  arch-chroot "${TARGET}" /usr/bin/git -C "${_bare}" rev-parse main >/dev/null \
    || die "${_bare} has no main"
}

init_privileged_git() {
  mountpoint -q "${TARGET}/srv" \
    || die "/srv is not mounted; refuse to write git onto @"
  [ -x "${TARGET}/usr/bin/git" ] || die "git missing on target"
  arch-chroot "${TARGET}" /usr/bin/id -u aios-checker >/dev/null \
    || die "aios-checker missing (systemd-sysusers)"
  arch-chroot "${TARGET}" /usr/bin/id -u aios-agent >/dev/null \
    || die "aios-agent missing (systemd-sysusers)"
  [ ! -e "${TARGET}/srv/aios/src" ] \
    || die "/srv/aios/src must not exist (HI-15)"
  [ -d "${TARGET}/srv/aios/etc-mirror" ] || die "etc-mirror missing before privileged git"
  mkdir -p "${TARGET}/srv/aios/git" || die "mkdir /srv/aios/git failed"
  write_machine_agents_md
  for _name in envelope memory skills agent checker state seeds; do
    init_one_git "${_name}"
  done
  arch-chroot "${TARGET}" /usr/bin/chown -R aios-checker:aios-checker /srv/aios/git \
    || die "chown /srv/aios/git failed"
  for _name in envelope memory skills agent checker state seeds; do
    arch-chroot "${TARGET}" /usr/bin/chown -R aios-agent:aios-agent "/srv/aios/${_name}" \
      || die "chown /srv/aios/${_name} failed"
  done
  [ -f "${TARGET}/srv/aios/envelope/hard-invariants.md" ] \
    || die "envelope worktree missing hard-invariants.md"
  [ -d "${TARGET}/srv/aios/seeds/work-runtime" ] \
    || die "seeds/work-runtime missing (HI-17)"
  [ -d "${TARGET}/srv/aios/seeds/work-runtime-bots" ] \
    || die "seeds/work-runtime-bots missing (HI-17)"
  [ -f "${TARGET}/srv/aios/checker/aios_checker/schema.py" ] \
    || die "checker worktree missing schema.py"
  [ -f "${TARGET}/srv/aios/state/packages.txt" ] \
    || die "state worktree missing packages.txt"
  grep -qx linux "${TARGET}/srv/aios/state/packages.txt" \
    || die "linux missing from packages.txt"
  grep -qx linux-lts "${TARGET}/srv/aios/state/packages.txt" \
    || die "linux-lts missing from packages.txt"
  [ -d "${TARGET}/srv/aios/etc-mirror" ] || die "etc-mirror missing after privileged git"
  [ ! -e "${TARGET}/srv/aios/src" ] || die "/srv/aios/src must not exist (HI-15)"
  [ ! -e "${TARGET}/srv/aios/.git" ] || die "/srv/aios must not be a git repository"
  arch-chroot "${TARGET}" /usr/bin/git -C /srv/aios/git/envelope.git rev-parse main >/dev/null \
    || die "git -C /srv/aios/git/envelope.git rev-parse main failed"
  arch-chroot "${TARGET}" /usr/bin/git -C /srv/aios/git/seeds.git cat-file -e main:work-runtime \
    || die "seeds.git missing work-runtime (HI-17)"
  arch-chroot "${TARGET}" /usr/bin/git -C /srv/aios/git/seeds.git cat-file -e main:work-runtime-bots \
    || die "seeds.git missing work-runtime-bots (HI-17)"
  arch-chroot "${TARGET}" /usr/bin/git -C /srv/aios/git/envelope.git cat-file -e main:hard-invariants.md \
    || die "envelope.git missing hard-invariants.md (HI-17)"
  arch-chroot "${TARGET}" /usr/bin/git -C /srv/aios/git/checker.git cat-file -e main:aios_checker/schema.py \
    || die "checker.git missing aios_checker/schema.py"
  log "privileged git trees"
}

configure_seatbelts() {
  ensure_l07_mounts
  configure_snapper
  write_packages_txt
  write_git_safe_directory
  init_etc_mirror
  create_first_snapshot
  copy_first_esp_generation
  materialise_seeds
  init_privileged_git
}

reboot_to_disk() {
  copy_log
  sync
  # Busy nested mounts after pacstrap must not abort into a getty reinstall
  # (that would zap-all a live disk). Lazy-unmount, then reboot.
  umount -R "${TARGET}" 2>/dev/null || umount -R -l "${TARGET}" 2>/dev/null || true
  TARGET_MOUNTED=0
  trap - EXIT
  log "rebooting to disk"
  systemctl reboot || reboot -f
  sleep 86400
}

require_root
require_live_iso
require_tools
acquire_lock
log "firstboot start"
require_uefi
verify_payload
probe_disks
confirm_disk
partition_and_mount
pacstrap_target
configure_target
configure_boot
configure_seatbelts
log "disk install complete"
reboot_to_disk
