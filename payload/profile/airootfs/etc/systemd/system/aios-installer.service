[Unit]
Description=AIOS installer
After=systemd-user-sessions.service getty.target getty@tty1.service serial-getty@ttyS0.service
Conflicts=getty@tty1.service serial-getty@ttyS0.service
ConditionPathExists=/usr/lib/aios/bin/installer

[Service]
Type=simple
ExecStart=/usr/lib/aios/bin/installer
TTYPath=/dev/console
StandardInput=tty
StandardOutput=tty
StandardError=tty
Restart=on-failure

[Install]
WantedBy=multi-user.target
